{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "learnJenkinsApp-TaskDefinition-Prod",
    "containerDefinitions": [
        {
            "name": "learnjenkinsapp",
            "image": "087972550529.dkr.ecr.ap-south-1.amazonaws.com/myjenkinsapp:#APP_VERSION#",
            "portMappings": [
                {
                    "name": "nginx-80-tip",
                    "hostPort": 80,
                    "containerPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::087972550529:role/ecsTaskExecutionRole"
}